6-10-21T17:27:20.203349Z","iopub.status.idle":"2026-10-21T17:27:20.206877Z","shell.execute_reply":"2026-10-21T17:27:20.206222Z"},"papermill":{"duration":0.00932,"end_time":"2026-10-21T17:27:20.208323+00:00","exception":false,"start_time":"2026-10-21T17:27:20.199003+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from torch import nn\n","from torch.nn import functional"]},{"cell_type":"code","execution_count":18,"id":"90aacd57","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:20.220006Z","iopub.status.busy":"2026-10-21T17:27:20.219345Z","iopub.status.idle":"2026-10-21T17:27:20.224773Z","shell.execute_reply":"2026-10-21T17:27:20.224021Z"},"papermill":{"duration":0.014352,"end_time":"2026-10-21T17:27:20.226263+00:00","exception":false,"start_time":"2026-10-21T17:27:20.211911+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\n","class EmbeddingLayer(nn.Module):\n","    def __init__(self,model_config:ModelConfig):\n","        super().__init__()\n","\n","        \"\"\"\n","        Always remember that embedding layer is not actually a neural laer with any activation function ,\n","        its just an 2d matrix lookup the matrix size is (vocab_size,d_model) but but but the d_model here is lets one array\n","         so that array is already have learnable parameter means in our case that 32 dim arrays have the values from the training \n","         for e.g:\n","         token_embeding[1] will be the embeding of token id 1 which is 32 dim embedding array\n","        \"\"\"\n","        self.token_embeddings=nn.Embedding(model_config.vocab_size,model_config.d_model)\n","        self.pos_embeddings = nn.Embedding(model_config.max_seq_len,model_config.d_model)\n","\n","    def forward(self,token_ids):\n","        pos_ids = torch.arange(token_ids.shape[1],device=token_ids.device)\n","        embedding = self.token_embeddings(token_ids) + self.pos_embeddings(pos_ids)\n","        return embedding\n"]},{"cell_type":"code","execution_count":19,"id":"e05714da","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:20.235021Z","iopub.status.busy":"2026-10-21T17:27:20.234749Z","iopub.status.idle":"2026-10-21T17:27:20.243224Z","shell.execute_reply":"2026-10-21T17:27:20.242491Z"},"papermill":{"duration":0.015135,"end_time":"2026-10-21T17:27:20.244876+00:00","exception":false,"start_time":"2026-10-21T17:27:20.229741+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class MultiHeadAttention(nn.Module):\n","    def __init__(self,model_config:ModelConfig):\n","        super().__init__()\n","\n","        self.config = model_config\n","        # initialize q,k,v\n","        self.w_q = nn.Linear(self.config.d_model,self.config.d_model,bias=False)\n","        self.w_k = nn.Linear(self.config.d_model,self.config.d_model,bias=False)\n","        self.w_v = nn.Linear(self.config.d_model,self.config.d_model,bias=False)\n","\n","        self.register_buffer(\n","                            \"casual_mask\", \n","                            torch.tril(\n","                                torch.ones(\n","                                    self.config.max_seq_len, \n","                                    self.config.max_seq_len\n","                                    )\n","                                )\n","                        )\n","        \n","        self.head_dim = self.config.d_model//self.config.num_heads\n","        \n","\n","        self.w_o = nn.Linear(self.config.d_model,self.config.d_model,bias=False)\n","\n","    def forward(self,x):\n","        # here x is the embeding and not raw x  and b is batch size, t is the current sequence length and d_model is hidden dimension\n","        # shape of x -> (b,t,d_model)\n","        q = self.w_q(x) # (b,t,d_model)\n","        k = self.w_k(x) # (b,t,d_model)\n","        v = self.w_v(x) # (b,t,d_model)\n","\n","        q = torch.reshape(q,(x.shape[0],x.shape[1],self.config.num_heads,self.head_dim))  # (b,t,num_head,head_dim)\n","        k = torch.reshape(k,(x.shape[0],x.shape[1],self.config.num_heads,self.head_dim))  # (b,t,num_head,head_dim)\n","        v = torch.reshape(v,(x.shape[0],x.shape[1],self.config.num_heads,self.head_dim))  # (b,t,num_head,head_dim)\n","\n","\n","        q = q.transpose(1,2) # (b,num_head,t,head_dim)\n","        k = k.transpose(1,2) # (b,num_head,t,head_dim)\n","        v = v.transpose(1,2) # (b,num_head,t,head_dim)\n","\n","        scores = q @ k.transpose(-2,-1) / (self.head_dim ** 0.5) # (b,num_head,t,t)\n","        mask = self.casual_mask[:x.shape[1],:x.shape[1]] # (t,t)\n","        masked_score = scores.masked_fill(mask==0,float(\"-inf\")) # (b,num_head,t,t)\n","        attention_weights = torch.softmax(masked_score,dim = -1) # (b,num_head,t,t)\n","        context_vector = attention_weights @ v # (b,num_head,t,head_dim)\n","\n","        context_vector = context_vector.transpose(1,2) # (b,t,num_head,head_dim) \n","        context_vector = context_vector.contiguous().view(x.shape) # (b,t,d_model)\n","        return self.w_o(context_vector) #(b,t,d_model) which is same as the input embedding \n"]},{"cell_type":"code","execution_count":20,"id":"eb44f828","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:20.254154Z","iopub.status.busy":"2026-10-21T17:27:20.253871Z","iopub.status.idle":"2026-10-21T17:27:20.258323Z","shell.execute_reply":"2026-10-21T17:27:20.257599Z"},"papermill":{"duration":0.010845,"end_time":"2026-10-21T17:27:20.259804+00:00","exception":false,"start_time":"2026-10-21T17:27:20.248959+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class FeedForward(nn.Module):\n","    def __init__(self,model_config:ModelConfig):\n","        super().__init__()\n","        self.config = model_config\n","        self.model = nn.Sequential(\n","            nn.Linear(self.config.d_model,4*self.config.d_model),\n","            nn.GELU(),\n","            nn.Linear(4*self.config.d_model,self.config.d_model)\n","        )\n","\n","    def forward(self,x):\n","        return self.model(x)"]},{"cell_type":"code","execution_count":21,"id":"e5b3a628","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:20.268795Z","iopub.status.busy":"2026-10-21T17:27:20.268165Z","iopub.status.idle":"2026-10-21T17:27:20.273011Z","shell.execute_reply":"2026-10-21T17:27:20.272337Z"},"papermill":{"duration":0.010813,"end_time":"2026-10-21T17:27:20.274419+00:00","exception":false,"start_time":"2026-10-21T17:27:20.263606+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class DecoderBlock(nn.Module):\n","    def __init__(self,model_config:ModelConfig):\n","        super().__init__()\n","\n","        self.config = model_config\n","        self.attention_layer = MultiHeadAttention(model_config)\n","        self.ffn = FeedForward(model_config)\n","        self.ln_1 =  nn.LayerNorm(model_config.d_model) # before attention layer\n","        self.ln_2 =  nn.LayerNorm(model_config.d_model) # before feed forward layer\n","\n","    def forward(self,x):\n","        x =  x+self.attention_layer(self.ln_1(x))\n","        x = x+ self.ffn(self.ln_2(x))\n","        return x\n","\n"]},{"cell_type":"code","execution_count":22,"id":"ee4899be","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:20.283734Z","iopub.status.busy":"2026-10-21T17:27:20.283314Z","iopub.status.idle":"2026-10-21T17:27:20.294634Z","shell.execute_reply":"2026-10-21T17:27:20.293848Z"},"papermill":{"duration":0.01779,"end_time":"2026-10-21T17:27:20.296147+00:00","exception":false,"start_time":"2026-10-21T17:27:20.278357+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class Transformer(nn.Module):\n","    def __init__(self,model_config:ModelConfig):\n","        super().__init__()\n","        self.config = model_config\n","        self.embedding_layer = EmbeddingLayer(model_config)\n","        self.drop = nn.Dropout(model_config.dropout)\n","        self.block = nn.ModuleList([DecoderBlock(model_config) for _ in range(model_config.num_layers)])\n","        self.ln_f = nn.LayerNorm(model_config.d_model)\n","        self.lm_head = nn.Linear(model_config.d_model,model_config.vocab_size,bias=False)\n","        self.lm_head.weight = self.embedding_layer.token_embeddings.weight\n","\n","        self.apply(self._init_weights)\n","\n","    def _init_weights(self,module):\n","        if isinstance(module, nn.Linear):\n","            module.weight = torch.nn.init.normal_(module.weight,mean=0.0,std=0.02)\n","            if module.bias is not None:\n","                module.bias = torch.nn.init.zeros_(module.bias)\n","        elif isinstance(module, nn.Embedding):\n","            module.weight = nn.init.normal_(module.weight,mean=0,std=0.02)\n","\n","        \n","    def forward(self,x,targets=None):\n","        embedding = self.embedding_layer(x)\n","        out = self.drop(embedding)\n","        for i in range(self.config.num_layers):\n","            out = self.block[i](out)\n","\n","        out_norm = self.ln_f(out)\n","        logits = self.lm_head(out_norm)\n","        loss = None\n","        if targets is not None:\n","            loss = functional.cross_entropy(\n","                logits.view(-1,self.config.vocab_size),\n","                targets.view(-1))\n","        return logits,loss\n","\n","    def generate(self,idx,max_new_tokens,temperature=1.0,top_k=None):\n","        for _ in range(max_new_tokens):\n","            idx_cond = idx[:,-self.config.max_seq_len:] #index conditional\n","            logits,_ = self(idx_cond)\n","            curr_id=0\n","            last_token = logits[:,-1,:]\n","            if temperature == 0.0: \n","                curr_id = torch.argmax(last_token,dim=-1,keepdim=True)\n","            elif temperature > 0:\n","                last_token = last_token/temperature \n","                if top_k is not None:\n","                    cutoff,_ = torch.topk(last_token,k=top_k)\n","                    last_token = last_token.masked_fill(last_token<cutoff[:,[-1]],float(\"-inf\"))\n","                probs = functional.softmax(last_token,dim=-1)\n","                curr_id = torch.multinomial(probs,num_samples=1)\n","            idx = torch.cat((idx, curr_id), dim=1)\n","\n","        return idx"]},{"cell_type":"code","execution_count":23,"id":"4833ecfd","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:20.306485Z","iopub.status.busy":"2026-10-21T17:27:20.305859Z","iopub.status.idle":"2026-10-21T17:27:21.324184Z","shell.execute_reply":"2026-10-21T17:27:21.323526Z"},"papermill":{"duration":1.02571,"end_time":"2026-10-21T17:27:21.326059+00:00","exception":false,"start_time":"2026-10-21T17:27:20.300349+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["model = Transformer(model_config).to(device)"]},{"cell_type":"code","execution_count":24,"id":"8d75f593","metadata":{"execution":{"iopub.execute_input":"2026-10-21T17:27:21.335431Z","iopub.status.busy":"2026-10-21T17:27:21.334521Z","iopub.status.idle":"2026-10-21T17:27:21.340263Z","shell.execute_reply":"2026-10-21T17:27:21.339727Z"},"papermill":{"duration":0.011715,"end_time":"2026-10-21T17:27:21.341639+00:00","exception":false,"start_time":"2026-10-21T17:27:21.329924+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["Transformer(\n","  (embedding_layer): EmbeddingLayer(\n","    (token_embeddings): Embedding(50257, 256)\n","    (pos_embeddings): Embedding(256, 256)\n","  )\n","  (drop): Dropout(p=0.1, inplace=False)\n","  (block): ModuleList(\n","    (0-5): 6 x DecoderBlock(\n","      (attention_layer): MultiHeadAttention(\n","        (w_q): Linear(in_features=256, out_features=256, bias=False)\n","        (w_k): Linear(in_features=256, out_features=256, bias=False)\n","        (w_v): Linear(in_features=256, out_features=256, bias=False)\n","        (w_o): Linear(in_features=256, out_features=256, bias=False)\n","      )\n","      (ffn): FeedForward(\n","        (model): Sequential(\n","          (0): Linear(in_features=256, out_featur