onfig.max_seq_len:] #index conditional\n            logits,_ = self(idx_cond)\n            curr_id=0\n            last_token = logits[:,-1,:]\n            if temperature == 0.0: \n                curr_id = torch.argmax(last_token,dim=-1,keepdim=True)\n            elif temperature > 0:\n                last_token = last_token/temperature \n                if top_k is not None:\n                    cutoff,_ = torch.topk(last_token,k=top_k)\n                    last_token = last_token.masked_fill(last_token<cutoff[:,[-1]],float(\"-inf\"))\n                probs = functional.softmax(last_token,dim=-1)\n                curr_id = torch.multinomial(probs,num_samples=1)\n            \n            if curr_id.item() == tokenizer.eot_token:\n                break\n            idx = torch.cat((idx, curr_id), dim=1)\n            \n\n        return idx","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T16:39:25.271085Z","iopub.execute_input":"2026-10-23T16:39:25.271628Z","iopub.status.idle":"2026-10-23T16:39:25.282772Z","shell.execute_reply.started":"2026-10-23T16:39:25.271601Z","shell.execute_reply":"2026-10-23T16:39:25.282133Z"}},"outputs":[],"execution_count":62},{"cell_type":"code","source":"model = Transformer(model_config).to(device)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T16:39:27.22992Z","iopub.execute_input":"2026-10-23T16:39:27.230596Z","iopub.status.idle":"2026-10-23T16:39:27.642479Z","shell.execute_reply.started":"2026-10-23T16:39:27.23057Z","shell.execute_reply":"2026-10-23T16:39:27.641829Z"}},"outputs":[],"execution_count":63},{"cell_type":"code","source":"model","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T16:09:46.023575Z","iopub.execute_input":"2026-10-23T16:09:46.02414Z","iopub.status.idle":"2026-10-23T16:09:46.030177Z","shell.execute_reply.started":"2026-10-23T16:09:46.024116Z","shell.execute_reply":"2026-10-23T16:09:46.029342Z"}},"outputs":[{"execution_count":19,"output_type":"ex